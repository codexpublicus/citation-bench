#!/usr/bin/env bash
#MISE description="Compare two engines' corpus runs: agreement, differing reporters and fields, timing"
#MISE alias="corpus:diff"
#USAGE flag "--corpus <corpus>" default="stare-pub" help="stare-pub: CAP cases and CourtListener records from stare.pub; eyecite-sample: eyecite's comparison sample of CourtListener opinions" {
#USAGE   choices "stare-pub" "eyecite-sample"
#USAGE }
#USAGE flag "--size <size>" default="1" help="eyecite-sample only, 1 or 10: the one-percent or ten-percent file" {
#USAGE   choices "1" "10"
#USAGE }
#USAGE flag "--base <engine>" default="eyecite" help="the run to compare against"
#USAGE flag "--candidate <engine>" default="citare" help="the run being compared"
set -euo pipefail
case "${usage_corpus:-stare-pub}" in
  stare-pub) name="$(uv run -q tools/fetch_stare.py name)" ;;
  eyecite-sample) name="corpus-${usage_size:-1}pct" ;;
esac
runs="results/$name"
out="reports/$name"
uv run -q bench/diff.py "$runs/${usage_base:-eyecite}.json" "$runs/${usage_candidate:-citare}.json" \
  --md "$out/report.md" --csv "$out/output.csv"
