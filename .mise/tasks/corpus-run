#!/usr/bin/env bash
#MISE description="Run one engine over a corpus and save the run: stare.pub's sample (default) or eyecite's comparison sample"
#MISE alias="corpus:run"
#USAGE arg "<engine>" help="eyecite or citare" {
#USAGE   choices "eyecite" "citare"
#USAGE }
#USAGE flag "--corpus <corpus>" default="stare-pub" help="stare-pub: CAP cases and CourtListener records from stare.pub; eyecite-sample: eyecite's comparison sample of CourtListener opinions" {
#USAGE   choices "stare-pub" "eyecite-sample"
#USAGE }
#USAGE flag "--size <size>" default="1" help="eyecite-sample only, 1 or 10: the one-percent or ten-percent file" {
#USAGE   choices "1" "10"
#USAGE }
#USAGE flag "--timeout <seconds>" default="900" help="restart the adapter if one opinion takes longer"
# CITARE_PATH=../citare runs a local checkout instead of the locked git commit, and
# CITARE_LABEL names the run (default: the commit).
set -euo pipefail
engine="${usage_engine:?}"
size="${usage_size:-1}"
case "${usage_corpus:-stare-pub}" in
  stare-pub)
    name="$(uv run -q tools/fetch_stare.py name)"
    corpus=".cache/corpora/$name"
    results="results/$name"
    [[ -f "$corpus/find.jsonl" ]] || uv run -q tools/fetch_stare.py
    ;;
  eyecite-sample)
    corpus=".cache/corpora/courtlistener-${size}pct"
    results="results/corpus-${size}pct"
    [[ -f "$corpus/find.jsonl" ]] || uv run -q tools/fetch_corpus.py --size "$size"
    ;;
esac
case "$engine" in
  eyecite)
    adapter="uv run -q --script adapters/eyecite/adapter.py"
    label="eyecite-$(uv run -q bench/baseline.py version)"
    ;;
  citare)
    mise run build-citare
    adapter="target/release/citare-bench-adapter"
    if [[ -n "${CITARE_LABEL:-}" ]]; then
      label="$CITARE_LABEL"
    elif [[ -n "${CITARE_PATH:-}" ]]; then
      label="citare-$(git -C "$CITARE_PATH" rev-parse --short HEAD)-local"
    else
      label="citare-$(grep -o 'citare?branch=main#[0-9a-f]\{7\}' adapters/citare/Cargo.lock | head -1 | cut -d'#' -f2)"
    fi
    ;;
esac
uv run -q bench/run.py --adapter "$adapter" --vectors "$corpus" \
  --timeout "${usage_timeout:-900}" --label "$label" \
  --save "$results/${engine}.json"
