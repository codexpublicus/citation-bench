{"id": "statutes-proposed/find/ussg/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "ussg", "corpus": "courtlistener-10pct", "opinion": "217943", "offset": 8207, "text": "after clean steps html, inline_whitespace"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "A decrease of two offense levels is warranted under U.S.S.G. § 3B1.2(b) if the \"defendant was a minor participant in any criminal activity.\"", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "U.S.S.G.", "section": "3B1.2"}, "metadata": {"pin_cite": "(b)", "jurisdiction": "United States"}, "reporter_normalized": "U.S.S.G.", "span": [52, 68], "type": "full_law", "year": null}]}}
