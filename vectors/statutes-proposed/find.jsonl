{"id": "statutes-proposed/find/fed_r_civ_p/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "fed_r_civ_p", "corpus": "courtlistener-10pct", "opinion": "435282", "offset": 4048, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f2d", "volume": "733", "page": "1333", "case": "1333-01", "url": "https://stare.pub/c/f2d/733/1333/", "data": "https://data.stare.pub/cap/f2d/733.zip", "member": "json/1333-01.json", "sha256": "339525e3aa3d384b9048667bb3c981ed019e05ec57480723b46d524d2b8fc9a6"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "However, we think that the trial court's assessment of damages was, according to the terms of the contract, incorrect and we reverse on this basis. Fed.R.Civ.P. 52(a).", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Fed.R.Civ.P.", "rule": "52"}, "metadata": {"pin_cite": "(a)", "jurisdiction": "United States"}, "reporter_normalized": "Fed. R. Civ. P.", "span": [148, 163], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/fed_r_civ_p/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "fed_r_civ_p", "corpus": "courtlistener-10pct", "opinion": "2438989", "offset": 507, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f-supp-2d", "volume": "328", "page": "769", "case": "0769-01", "url": "https://stare.pub/c/f-supp-2d/328/769/", "data": "https://data.stare.pub/cap/f-supp-2d/328.zip", "member": "json/0769-01.json", "sha256": "116cadc5b927bbc1fce7a00da379ba8f63b21523c63ac4afc5f54bb1e1c59c4f"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "Before the Court is defendant BFI Waste Systems of North America, Inc.'s (\"BFI\") motion to dismiss count two of plaintiff's complaints, pursuant to Fed.R.Civ.P. 12(b)(6), for the failure to state a claim upon which relief can be granted.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Fed.R.Civ.P.", "rule": "12"}, "metadata": {"pin_cite": "(b)(6)", "jurisdiction": "United States"}, "reporter_normalized": "Fed. R. Civ. P.", "span": [148, 163], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/fed_r_civ_p/2", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "fed_r_civ_p", "corpus": "courtlistener-10pct", "opinion": "4692747", "offset": 6236, "text": "after clean steps html, inline_whitespace"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "See Fed. R. Civ. P. 60(b)(1).", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Fed. R. Civ. P.", "rule": "60"}, "metadata": {"pin_cite": "(b)(1)", "jurisdiction": "United States"}, "reporter_normalized": "Fed. R. Civ. P.", "span": [4, 22], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/us_const/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "us_const", "corpus": "courtlistener-10pct", "opinion": "1005412", "offset": 6974, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f-appx", "volume": "19", "page": "97", "case": "0097-01", "url": "https://stare.pub/c/f-appx/19/97/", "data": "https://data.stare.pub/cap/f-appx/19.zip", "member": "json/0097-01.json", "sha256": "c670a3057cd3246c563aa3a15c875303dec5a4e14c87a8185c777a3e13164c55"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The Eighth Amendment expressly prohibits the infliction of \"cruel\nand unusual punishments.\" U.S. Const. amend. VIII.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "U.S. Const.", "amendment": "VIII"}, "metadata": {"jurisdiction": "United States"}, "reporter_normalized": "U.S. Const.", "span": [92, 115], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/us_const/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "us_const", "corpus": "stare-pub", "source": "cap", "slug": "ill-app-3d", "volume": "197", "page": "400", "case": "0400-01", "url": "https://stare.pub/c/ill-app-3d/197/400/", "data": "https://data.stare.pub/cap/ill-app-3d/197.zip", "member": "json/0400-01.json", "sha256": "683c2ad6c6ea898ff74691b7a0c1f09498992ea89b45745fb12d838cf6adf09e", "offset": 2430, "text": "casebody.opinions[].text joined with blank lines", "courtlistener_opinion": "7023861"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The Court discussed in detail the due process clause of the fourteenth amendment regarding the limits of the State courts to obtain valid personal jurisdiction over a nonresident defendant. (U.S. Const., amend. XIV.)", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "U.S. Const.", "amendment": "XIV"}, "metadata": {"jurisdiction": "United States"}, "reporter_normalized": "U.S. Const.", "span": [191, 214], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/us_const/2", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "us_const", "corpus": "courtlistener-10pct", "opinion": "1446766", "offset": 6396, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f-supp", "volume": "928", "page": "302", "case": "0302-01", "url": "https://stare.pub/c/f-supp/928/302/", "data": "https://data.stare.pub/cap/f-supp/928.zip", "member": "json/0302-01.json", "sha256": "21dff88dd2d50aec6c3987045019f4bb81da76dae78300c73adbe53ef08b1783"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The Commerce Clause of the United States Constitution gives Congress the power \"[t]o regulate Commerce with foreign Nations, and among the several States, and with the Indian Tribes.\" U.S. Const. art. I, § 8, cl. 3.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "U.S. Const.", "article": "I", "section": "8"}, "metadata": {"pin_cite": "cl. 3", "jurisdiction": "United States"}, "reporter_normalized": "U.S. Const.", "span": [184, 207], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/us_const/3", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "us_const", "corpus": "courtlistener-10pct", "opinion": "2654061", "offset": 7825, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f3d", "volume": "743", "page": "802", "case": "0802-01", "url": "https://stare.pub/c/f3d/743/802/", "data": "https://data.stare.pub/cap/f3d/743.zip", "member": "json/0802-01.json", "sha256": "7c2fd7f671f706baca3c582b95330d5d873a4a5d73c787ae31c0e27cbe712c6f"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The Constitution empowers Congress “[t]o define and punish Piracies and\n\nFelonies committed on the high Seas, and Offences against the Law of Nations.”\n\nU.S. Const. Art. I, § 8, cl. 10.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "U.S. Const.", "article": "I", "section": "8"}, "metadata": {"pin_cite": "cl. 10", "jurisdiction": "United States"}, "reporter_normalized": "U.S. Const.", "span": [153, 176], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/treas_reg/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "treas_reg", "corpus": "courtlistener-10pct", "opinion": "599291", "offset": 6026, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f2d", "volume": "985", "page": "36", "case": "0036-01", "url": "https://stare.pub/c/f2d/985/36/", "data": "https://data.stare.pub/cap/f2d/985.zip", "member": "json/0036-01.json", "sha256": "ed8a2702b6ccd37537de5d345c6e0670e4de6fad55e5199e176f3b933ecc59f1"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "If a charitable contribution is made of property other than money, the amount of the contribution is the fair market value of the property at the time of the contribution. Treas.Reg. § 1.170A-1(c)(1).", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Treas.Reg.", "section": "1.170A-1"}, "metadata": {"pin_cite": "(c)(1)", "jurisdiction": "United States"}, "reporter_normalized": "Treas. Reg.", "span": [172, 193], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/treas_reg/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "treas_reg", "corpus": "stare-pub", "source": "cap", "slug": "f-supp", "volume": "407", "page": "1326", "case": "1326-01", "url": "https://stare.pub/c/f-supp/407/1326/", "data": "https://data.stare.pub/cap/f-supp/407.zip", "member": "json/1326-01.json", "sha256": "0eba02b3a2a58719388264342b2cb416d475f9100a692c2610aac4d8f849b729", "offset": 38201, "text": "casebody.opinions[].text joined with blank lines", "courtlistener_opinion": "2281146"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "See Treas.Reg. § 1.48-1(C).", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Treas.Reg.", "section": "1.48-1"}, "metadata": {"pin_cite": "(C)", "jurisdiction": "United States"}, "reporter_normalized": "Treas. Reg.", "span": [4, 23], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/ussg/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "ussg", "corpus": "courtlistener-10pct", "opinion": "217943", "offset": 8207, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f3d", "volume": "641", "page": "1189", "case": "1189-01", "url": "https://stare.pub/c/f3d/641/1189/", "data": "https://data.stare.pub/cap/f3d/641.zip", "member": "json/1189-01.json", "sha256": "287527a048aecb172962a4bf3fed7a42ec398cf973ddb780a02d259152a3696d"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "A decrease of two offense levels is warranted under U.S.S.G. § 3B1.2(b) if the \"defendant was a minor participant in any criminal activity.\"", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "U.S.S.G.", "section": "3B1.2"}, "metadata": {"pin_cite": "(b)", "jurisdiction": "United States"}, "reporter_normalized": "U.S.S.G.", "span": [52, 68], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/ussg/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "ussg", "corpus": "courtlistener-10pct", "opinion": "808602", "offset": 4316, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f3d", "volume": "694", "page": "898", "case": "0898-01", "url": "https://stare.pub/c/f3d/694/898/", "data": "https://data.stare.pub/cap/f3d/694.zip", "member": "json/0898-01.json", "sha256": "c0c5c608f4d5dfd7d46d91ee04a052b6b66ac811fc5750098e598a45b43c3533"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The district court concluded that Dowell\nhad two prior qualifying felony drug convictions that\nmade him a career offender under U.S.S.G. § 4B1.1.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "U.S.S.G.", "section": "4B1.1"}, "metadata": {"jurisdiction": "United States"}, "reporter_normalized": "U.S.S.G.", "span": [128, 144], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/fed_reg/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "fed_reg", "corpus": "courtlistener-10pct", "opinion": "118239", "offset": 2902, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "us", "volume": "524", "page": "498", "case": "0498-01", "url": "https://stare.pub/c/us/524/498/", "data": "https://data.stare.pub/cap/us/524.zip", "member": "json/0498-01.json", "sha256": "003164785df767dfa6ea52984d5d1fb309cd326af60db7f469bba6c2bed2da46"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "When a breakdown in those negotiations resulted in a nationwide strike, President Truman issued an Executive order directing Secretary of the Interior Julius Krug to take possession of all bituminous coal mines and to negotiate \"appropriate changes in the terms and conditions of employment\" of miners with the UMWA. 11 Fed. Reg. 5593 (1946).", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"volume": "11", "reporter": "Fed. Reg.", "page": "5593"}, "metadata": {"jurisdiction": "United States", "year": "1946"}, "reporter_normalized": "Fed. Reg.", "span": [317, 334], "type": "full_law", "year": 1946}]}}
{"id": "statutes-proposed/find/fed_reg/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "fed_reg", "corpus": "courtlistener-10pct", "opinion": "509500", "offset": 38427, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f2d", "volume": "852", "page": "1316", "case": "1316-01", "url": "https://stare.pub/c/f2d/852/1316/", "data": "https://data.stare.pub/cap/f2d/852.zip", "member": "json/1316-01.json", "sha256": "8992c88dd89c3cd97d0bce5b3939021652edccee10b5fbc92af12a0d47684a52"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "EPA conceded as much when it concluded in 1985 that the term \"processing\" had no standard definition or plain meaning. 50 Fed.Reg. 40,293 (1985).", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"volume": "50", "reporter": "Fed.Reg.", "page": "40,293"}, "metadata": {"jurisdiction": "United States", "year": "1985"}, "reporter_normalized": "Fed. Reg.", "span": [119, 137], "type": "full_law", "year": 1985}]}}
{"id": "statutes-proposed/find/stat/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "stat", "corpus": "courtlistener-10pct", "opinion": "145762", "offset": 68665, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "us", "volume": "549", "page": "225", "case": "0225-01", "url": "https://stare.pub/c/us/549/225/", "data": "https://data.stare.pub/cap/us/549.zip", "member": "json/0225-01.json", "sha256": "56c46ff14276cf648757782651870111a001d148854032f04bb1a01969fab73d"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "There, the remand order had been predicated upon a finding that the cause of action was not a \"covered\" class-action suit as defined by the Securities Litigation Uniform Standards Act of 1998 (SLUSA), 112 Stat. 3227, and therefore that the federal courts lacked jurisdiction.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"volume": "112", "reporter": "Stat.", "page": "3227"}, "metadata": {"jurisdiction": "United States"}, "reporter_normalized": "Stat.", "span": [201, 215], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/stat/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "stat", "corpus": "courtlistener-10pct", "opinion": "3358001", "offset": 128, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cl", "ref": "3362466/acabd3440a9f8f8c", "url": "https://data.stare.pub/cl/c/3362466/acabd3440a9f8f8c.json.gz", "sha256": "639ea63f75967b735222916244db17d08b78c092552b68e1c5b14277f3727916"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "On Labor Day 1974, President Ford signed into law the Employee Retirement Income Security Act of 1974, popularly known as ERISA. 88 Stat. 829 (1974).", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"volume": "88", "reporter": "Stat.", "page": "829"}, "metadata": {"jurisdiction": "United States", "year": "1974"}, "reporter_normalized": "Stat.", "span": [129, 141], "type": "full_law", "year": 1974}]}}
{"id": "statutes-proposed/find/pub_l/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "pub_l", "corpus": "stare-pub", "source": "cap", "slug": "f-supp", "volume": "393", "page": "553", "case": "0553-01", "url": "https://stare.pub/c/f-supp/393/553/", "data": "https://data.stare.pub/cap/f-supp/393.zip", "member": "json/0553-01.json", "sha256": "050163bb07b4807a545b8813fdbc6dfe5fa101a23ac9aa41052b938353e24d69", "offset": 16695, "text": "casebody.opinions[].text joined with blank lines", "courtlistener_opinion": "1452705"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "As outlined above, Congress rejected automatic eligibility for rollback cases in Pub.L. No. 93-233.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Pub.L.", "title": "93-233"}, "metadata": {"jurisdiction": "United States"}, "reporter_normalized": "Pub. L.", "span": [81, 98], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/pub_l/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "pub_l", "corpus": "courtlistener-10pct", "opinion": "1415892", "offset": 5468, "text": "after clean steps html, inline_whitespace", "stare_pub": {"source": "cap", "slug": "f-supp", "volume": "455", "page": "816", "case": "0816-01", "url": "https://stare.pub/c/f-supp/455/816/", "data": "https://data.stare.pub/cap/f-supp/455.zip", "member": "json/0816-01.json", "sha256": "91da04badddbd9cf4d50302d870a06725fbb60954ee3b3b5af60c744aec068b3"}}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The House Conference Report accompanying Pub.L. 93-406 specifies that ERISA civil actions, whether filed in state or federal courts, \"are to be regarded as arising under the laws of the United States in similar fashion to those brought under Section 301 of the Labor-Management Relations Act of 1947.\"", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Pub.L.", "title": "93-406"}, "metadata": {"jurisdiction": "United States"}, "reporter_normalized": "Pub. L.", "span": [41, 54], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/usc_et_seq/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "usc_et_seq", "corpus": "stare-pub", "source": "cap", "slug": "f-supp", "volume": "76", "page": "121", "case": "0121-01", "url": "https://stare.pub/c/f-supp/76/121/", "data": "https://data.stare.pub/cap/f-supp/76.zip", "member": "json/0121-01.json", "sha256": "cd88c586adc8f47926b4016cc70f3bfc1e52be015a1122b7a793f51e099e808c", "offset": 4162, "text": "casebody.opinions[].text joined with blank lines", "courtlistener_opinion": "2304383"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "Because defendant was a commercial airlines, it was subject to the jurisdiction of the Railway Labor Act, 45 U.S.C.A. § 151 et seq., with respect to its airlines activities.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"title": "45", "reporter": "U.S.C.A.", "section": "151"}, "metadata": {"pin_cite": "et seq.", "jurisdiction": "United States"}, "reporter_normalized": "U.S.C.", "span": [106, 123], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/usc_et_seq/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "usc_et_seq", "corpus": "stare-pub", "source": "cap", "slug": "f2d", "volume": "292", "page": "645", "case": "0645-01", "url": "https://stare.pub/c/f2d/292/645/", "data": "https://data.stare.pub/cap/f2d/292.zip", "member": "json/0645-01.json", "sha256": "398b7a8d357c607080bebec72c8b9e6de180ba6e32fcbf89d1dcfb60da931d8d", "offset": 21, "text": "casebody.opinions[].text joined with blank lines", "courtlistener_opinion": "6921538"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The three actions involved in this case, which were consolidated for trial, were instituted by the former Secretary of Labor under the Fair Labor Standards Act, 29 U.S.C.A. § 201 et seq.", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"title": "29", "reporter": "U.S.C.A.", "section": "201"}, "metadata": {"pin_cite": "et seq.", "jurisdiction": "United States"}, "reporter_normalized": "U.S.C.", "span": [161, 178], "type": "full_law", "year": null}]}}
{"id": "statutes-proposed/find/usc_range/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "usc_range", "corpus": "stare-pub", "source": "cl", "ref": "8242608/b7d7acd3f7aa3474", "url": "https://data.stare.pub/cl/c/8242608/b7d7acd3f7aa3474.json.gz", "sha256": "7471c2d8d42df4f8642a4a6277203741b639070dd04a0fda1173f3dee4a70d62", "offset": 7927, "text": "casebody.opinions[].text joined with blank lines", "courtlistener_opinion": "6343448"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The Controlled Substances Act (\"CSA\"), 21 U.S.C. §§ 801-904, the federal law which governs the use and trafficking of controlled substances, including marijuana, explicitly addresses the issue of federal preemption of state law:", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"title": "21", "reporter": "U.S.C.", "section": "801-904"}, "metadata": {"jurisdiction": "United States"}, "reporter_normalized": "U.S.C.", "span": [39, 59], "type": "full_law", "year": null}]}}
