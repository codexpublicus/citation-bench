{"id": "statutes-proposed/find/treas_reg/0", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "treas_reg", "corpus": "courtlistener-10pct", "opinion": "599291", "offset": 6026, "text": "after clean steps html, inline_whitespace"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "If a charitable contribution is made of property other than money, the amount of the contribution is the fair market value of the property at the time of the contribution. Treas.Reg. § 1.170A-1(c)(1).", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Treas.Reg.", "section": "1.170A-1"}, "metadata": {"pin_cite": "(c)(1)", "jurisdiction": "United States"}, "reporter_normalized": "Treas. Reg.", "span": [172, 193], "type": "full_law", "year": null}]}}
