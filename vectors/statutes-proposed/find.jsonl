{"id": "statutes-proposed/find/pub_l/1", "kind": "find", "source": {"file": "vectors/statutes-proposed/README.md", "test": "pub_l", "corpus": "courtlistener-10pct", "opinion": "1415892", "offset": 5468, "text": "after clean steps html, inline_whitespace"}, "provenance": {"status": "proposed", "drafted": "by hand from the opinion text, 2026-10-17", "note": "needs human review"}, "input": {"text": "The House Conference Report accompanying Pub.L. 93-406 specifies that ERISA civil actions, whether filed in state or federal courts, \"are to be regarded as arising under the laws of the United States in similar fashion to those brought under Section 301 of the Labor-Management Relations Act of 1947.\"", "format": "plain", "clean_steps": []}, "options": {"remove_ambiguous": false}, "expected": {"citations": [{"groups": {"reporter": "Pub.L.", "title": "93-406"}, "metadata": {"jurisdiction": "United States"}, "reporter_normalized": "Pub. L.", "span": [41, 54], "type": "full_law", "year": null}]}}
