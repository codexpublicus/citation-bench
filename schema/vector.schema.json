{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codexpublicus/citation-bench/schema/vector.schema.json",
  "title": "Conformance vector",
  "description": "One line of a vectors/<source>/*.jsonl file.",
  "type": "object",
  "required": ["id", "source", "input", "expected"],
  "properties": {
    "id": {"type": "string", "description": "Unique and stable: <source>/<suite>/<test>/<index>."},
    "source": {
      "type": "object",
      "required": ["engine", "version"],
      "properties": {
        "engine": {"type": "string"}, "version": {"type": "string"},
        "file": {"type": "string"}, "test": {"type": "string"}, "note": {"type": "string"}
      }
    },
    "input": {
      "type": "object",
      "required": ["text", "format"],
      "properties": {
        "text": {"type": "string"},
        "format": {"enum": ["plain", "html"]},
        "clean_steps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "options": {"type": "object", "properties": {"remove_ambiguous": {"type": "boolean"}}},
    "expected": {
      "type": "object",
      "required": ["citations"],
      "properties": {"citations": {"type": "array", "items": {"$ref": "citation.schema.json"}}}
    }
  }
}
